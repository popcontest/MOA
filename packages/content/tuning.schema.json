{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://motherofall.invalid/schemas/tuning.json",
  "title": "Feel tuning",
  "description": "Presentation only. Nothing here may reach packages/sim; a live slider that did would silently invalidate every replay hash in the project. Bound to dev-overlay sliders in M3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "palette",
    "terrain",
    "trailStyle",
    "shake",
    "hitStop",
    "slowMo",
    "particles",
    "camera"
  ],
  "definitions": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "arenaPalette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skyTop",
        "skyHorizon",
        "crust",
        "soilSurface",
        "soilDeep",
        "soilFloor"
      ],
      "properties": {
        "skyTop": {
          "$ref": "#/definitions/hex"
        },
        "skyHorizon": {
          "$ref": "#/definitions/hex"
        },
        "crust": {
          "$ref": "#/definitions/hex"
        },
        "soilSurface": {
          "$ref": "#/definitions/hex"
        },
        "soilDeep": {
          "$ref": "#/definitions/hex"
        },
        "soilFloor": {
          "$ref": "#/definitions/hex"
        }
      }
    },
    "numbers": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_note": {
      "type": "string"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arenas",
        "players",
        "playerOutline",
        "projectile",
        "trail"
      ],
      "properties": {
        "arenas": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/arenaPalette"
          }
        },
        "players": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/hex"
          }
        },
        "playerOutline": {
          "$ref": "#/definitions/hex"
        },
        "projectile": {
          "$ref": "#/definitions/hex"
        },
        "projectileOutline": {
          "$ref": "#/definitions/hex"
        },
        "trail": {
          "$ref": "#/definitions/hex"
        },
        "hudInk": {
          "$ref": "#/definitions/hex"
        },
        "hudPanel": {
          "$ref": "#/definitions/hex"
        }
      }
    },
    "terrain": {
      "$ref": "#/definitions/numbers"
    },
    "trailStyle": {
      "$ref": "#/definitions/numbers"
    },
    "shake": {
      "$ref": "#/definitions/numbers"
    },
    "hitStop": {
      "$ref": "#/definitions/numbers"
    },
    "slowMo": {
      "$ref": "#/definitions/numbers"
    },
    "particles": {
      "$ref": "#/definitions/numbers"
    },
    "camera": {
      "$ref": "#/definitions/numbers"
    }
  }
}
