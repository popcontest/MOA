{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://motherofall.invalid/schemas/arenas.json",
  "title": "Arena content",
  "type": "object",
  "required": ["arenas"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "arenas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "width", "height", "roughness", "minGround", "maxGround"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 64 },
          "height": { "type": "integer", "minimum": 64 },
          "roughness": { "type": "number", "minimum": 0, "maximum": 2 },
          "minGround": { "type": "integer", "minimum": 2 },
          "maxGround": { "type": "integer", "minimum": 2 }
        }
      }
    }
  }
}
