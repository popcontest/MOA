{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://motherofall.invalid/schemas/weapons.json",
  "title": "Weapon content",
  "type": "object",
  "required": ["weapons"],
  "properties": {
    "$schema": { "type": "string" },
    "weapons": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/weapon" }
    }
  },
  "additionalProperties": false,

  "definitions": {
    "weapon": {
      "type": "object",
      "required": ["id", "name", "family", "triggers", "effects"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "fireable": { "type": "boolean" },
        "spawn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "speedScale": { "type": "number", "exclusiveMinimum": 0 },
            "gravityScale": { "type": "number" },
            "windScale": { "type": "number" },
            "fuse": { "type": "number", "minimum": -1 }
          }
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["on", "effects"],
            "additionalProperties": false,
            "properties": {
              "on": {
                "enum": [
                  "impactPlayer",
                  "impactTerrain",
                  "apex",
                  "fuse",
                  "leaveArena",
                  "budgetEnd",
                  "rest"
                ]
              },
              "effects": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "effects": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/effect" }
        }
      }
    },

    "effect": {
      "oneOf": [
        { "$ref": "#/definitions/blast" },
        { "$ref": "#/definitions/spawn" },
        { "$ref": "#/definitions/mode" },
        { "$ref": "#/definitions/expire" }
      ]
    },

    "blast": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "blast" },
        "maxDamage": { "type": "number", "minimum": 0 },
        "blastRadius": { "type": "number", "minimum": 0 },
        "carveRadius": { "type": "number", "minimum": 0 },
        "fillRadius": { "type": "number", "minimum": 0 }
      }
    },

    "spawn": {
      "type": "object",
      "required": ["kind", "childId", "count"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "spawn" },
        "childId": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1, "maximum": 32 },
        "spreadDeg": { "type": "number", "minimum": 0, "maximum": 360 },
        "speedScale": { "type": "number", "minimum": 0 },
        "inheritVelocity": { "type": "boolean" },
        "consumeParent": { "type": "boolean" }
      }
    },

    "mode": {
      "type": "object",
      "required": ["kind", "mode", "speed", "budgetSteps"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "mode" },
        "mode": { "enum": ["roll", "burrow"] },
        "speed": { "type": "number", "exclusiveMinimum": 0 },
        "budgetSteps": { "type": "integer", "minimum": 1 },
        "carveRadius": { "type": "number", "minimum": 0 },
        "onEnd": { "type": "array", "items": { "type": "string" } },
        "onRest": { "type": "array", "items": { "type": "string" } },
        "onImpactPlayer": { "type": "array", "items": { "type": "string" } }
      }
    },

    "expire": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": { "kind": { "const": "expire" } }
    }
  }
}
